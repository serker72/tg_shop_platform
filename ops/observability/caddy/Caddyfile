# Reverse proxy for the observability stack. Automatic HTTPS:
#   public domains     -> Let's Encrypt / ZeroSSL (ports 80/443 must be reachable);
#   *.localhost / IPs  -> Caddy internal CA (local checks, use curl -k).
# Domains come from .env (GRAFANA_DOMAIN, GLITCHTIP_DOMAIN).

{$GRAFANA_DOMAIN} {
	encode zstd gzip
	reverse_proxy grafana:3000
}

{$GLITCHTIP_DOMAIN} {
	encode zstd gzip
	# GlitchTip accepts SDK envelopes up to tens of MB
	request_body {
		max_size 50MB
	}
	reverse_proxy glitchtip-web:8000
}
