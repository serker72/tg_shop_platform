# =============================================================================
# Template of the main env file. `make env` generates .env from it with random secrets
# (change_me*, ENCRYPTION_KEY, POSTGRES_MONITORING_PASSWORD; mode 600) — see README.md.
# Then fill in manually: MASTER_BOT_TOKEN, ALERT_TELEGRAM_*, domains, Alloy URLs.
# =============================================================================
# Project Environment
# =============================================================================
# loc | test | stage | prod (for local development set PROJECT_ENVIRONMENT=loc in .env)
PROJECT_ENVIRONMENT=stage
PROJECT_NAME=tg_shop_platform
# NOTE: values are read by docker compose and by `source` in the Makefile:
# do not use unescaped `$`, backticks or unbalanced quotes in values (wrap such secrets in '...').

# Container user for app images; set to the owner of LOGS_DATA_DIR (`id -u` / `id -g`).
# Host data dirs (at least LOGS_DATA_DIR) MUST belong to APP_UID:APP_GID, otherwise app
# containers cannot write logs/temporary archives (`make init-dirs` and archive-audit fail
# with a chown hint). On a new server, once:
#   sudo mkdir -p /opt/tg_shop_platform_data && sudo chown -R 1000:1000 /opt/tg_shop_platform_data
#   make init-dirs
APP_UID=1000
APP_GID=1000

# =============================================================================
# Data Directories (bind mounts; create them with `make init-dirs`)
# =============================================================================
PROJECT_DATA_DIR=/opt/tg_shop_platform_data
POSTGRES_DATA_DIR="${PROJECT_DATA_DIR}/db"
REDIS_DATA_DIR="${PROJECT_DATA_DIR}/redis"
RABBITMQ_DATA_DIR="${PROJECT_DATA_DIR}/rabbitmq"
MINIO_DATA_DIR="${PROJECT_DATA_DIR}/minio"
# Owned by APP_UID:APP_GID (see above); archive spool lives in ${LOGS_DIR}/system/tmp.
LOGS_DATA_DIR="${PROJECT_DATA_DIR}/logs"

# Logs (inside container): LOGS_DIR is the path in the app container where LOGS_DATA_DIR
# (host path above) is bind-mounted. Do not confuse the two.
# When running outside a container (local uv run), set LOGS_DIR to a local writable
# directory, e.g. LOGS_DIR=./var/logs.
LOGS_DIR=/app/logs

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tg_shop_platform
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tg_shop_platform

# =============================================================================
# Host ports (published on 127.0.0.1; `make env-test` shifts them by +20000)
# =============================================================================
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
RABBITMQ_PORT_HOST=5672
RABBITMQ_MGMT_PORT_HOST=15672
MINIO_API_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001

# =============================================================================
# SQLAlchemy
# =============================================================================
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0
# Connect/read timeout in seconds (> 0). On timeout the permission cache falls back to PostgreSQL.
REDIS_SOCKET_TIMEOUT=0.3

# =============================================================================
# RABBITMQ
# =============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=tg_shop_platform
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/

# =============================================================================
# MINIO (S3-compatible object storage)
# =============================================================================
MINIO_ENDPOINT=minio:9000
# Override the pinned MinIO image (pgsty community fork, tag@digest) if needed:
# MINIO_IMAGE=
# MinIO root credentials (min 8 chars for the secret key)
MINIO_ACCESS_KEY=tg_shop_platform
MINIO_SECRET_KEY=change_me_min_8_chars
MINIO_BUCKET=tg-shop
# https for MINIO_ENDPOINT; applies only to STORAGE_BACKEND=minio
MINIO_SECURE=false
# Бакет архива аудита (ops/scripts/archive_audit_partitions.py), STORAGE_BACKEND=minio.
# Пусто = основной бакет (STORAGE_BUCKET / MINIO_BUCKET); ключи всегда под префиксом audit/.
# Отдельный бакет рекомендуется: Object Lock, lifecycle и права доступа отдельно от загрузок.
# Бакет должен существовать заранее.
MINIO_AUDIT_ARCHIVE_BUCKET=

# =============================================================================
# Storage backend selection
# =============================================================================
# minio | s3
# minio: uses MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY (default, required by design)
# s3:    AWS S3 or any S3-compatible endpoint; uses STORAGE_ENDPOINT / STORAGE_REGION /
#        STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY (applied only when STORAGE_BACKEND=s3).
#        Leave the optional values empty to use defaults.
STORAGE_BACKEND=minio
# Full URL with http:// or https:// scheme and host for the s3 backend,
# e.g. https://s3.eu-central-1.amazonaws.com (empty = AWS default endpoint; ignored by minio)
STORAGE_ENDPOINT=
# AWS region for the s3 backend (empty = us-east-1)
STORAGE_REGION=
# Bucket for uploads (empty = MINIO_BUCKET)
STORAGE_BUCKET=
# Audit archive bucket for the s3 backend (empty = STORAGE_BUCKET / MINIO_BUCKET; keys under audit/)
STORAGE_AUDIT_ARCHIVE_BUCKET=
# S3 credentials (s3 backend only; MINIO_* credentials are never used for s3).
# Empty = standard boto3 credential chain (AWS_* env, shared profile, IAM role).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# =============================================================================
# SECURITY
# =============================================================================
# Fernet key for encrypting secrets (bot tokens etc.). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The key is stored outside the DB and outside git.
ENCRYPTION_KEY=
# Optional: previous keys for rotation via MultiFernet (comma-separated).
# Effective key list = ENCRYPTION_KEY (current, first) + ENCRYPTION_KEYS_OLD.
ENCRYPTION_KEYS_OLD=

# =============================================================================
# BOT
# =============================================================================
MASTER_BOT_TOKEN=

# --- Observability (application) ---
# HTTP endpoints of each bot process: /health/live, /health/ready, /metrics.
# The port is NOT published; Docker healthcheck and Alloy reach it inside the network.
OBSERVABILITY_HTTP_HOST=0.0.0.0
OBSERVABILITY_HTTP_PORT=8080
# Timeout (s) of each dependency check in /health/ready
OBSERVABILITY_HEALTH_TIMEOUT_SECONDS=2.0
# Worker heartbeat is considered stale after this many seconds
OBSERVABILITY_HEARTBEAT_TTL_SECONDS=30
# Cache of the /health/ready result (s), protects dependencies from frequent probes
OBSERVABILITY_READY_CACHE_TTL_SECONDS=1.0
# GlitchTip/Sentry DSN (empty = error reporting disabled); written by make obs-bootstrap
SENTRY_DSN=
# Environment tag of events (empty = PROJECT_ENVIRONMENT)
SENTRY_ENVIRONMENT=
# Share of traced transactions 0.0..1.0 (0.0 = errors only)
SENTRY_TRACES_SAMPLE_RATE=0.0
# Release of events (empty = tg-shop-platform@<app version>, see docs/ops/versioning.md);
# set only to override the computed value
SENTRY_RELEASE=

# --- Docker log rotation (json-file, all services of both compose files) ---
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# --- Collection agent: Grafana Alloy (docker-compose.yml, profile observability) ---
# make agent-up / agent-down / agent-logs — see docs/ops/observability.md.
# WAL/positions of Alloy (bind mount, created by make init-dirs)
ALLOY_DATA_DIR="${PROJECT_DATA_DIR}/alloy"
# Alloy UI on 127.0.0.1
ALLOY_PORT_HOST=12345
# Label `host` on all logs/metrics (empty = container hostname)
ALLOY_HOST_LABEL=vps1
# 1 = obs stack on the same host: Alloy joins its network (ops/observability/alloy/
#     compose.single-host.yml) and the URLs use service names loki/prometheus;
#     order: first `make obs-up`, then `make agent-up` (the obs network must exist).
# 0 = VPS 1 -> VPS 2 over VPN: OBS_LOKI_PUSH_URL / OBS_PROMETHEUS_REMOTE_WRITE_URL point to
#     the VPN IP of VPS 2 (docs/ops/network.md). GlitchTip: on VPS 2 set GLITCHTIP_INTERNAL_URL
#     to http://<VPN IP of VPS 2>:8000 before `make obs-up` (SENTRY_DSN is built from it),
#     then copy SENTRY_DSN from .env of VPS 2 to .env of VPS 1.
ALLOY_SINGLE_HOST=0
# One line per key; change the VALUE, do not add a second line (with duplicate keys the last
# one wins). Values:
#   VPS 1 -> VPS 2 over VPN (ALLOY_SINGLE_HOST=0): replace 10.10.0.2 with the VPN IP of VPS 2;
#   single host (ALLOY_SINGLE_HOST=1): OBS_LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push,
#     OBS_PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write
OBS_LOKI_PUSH_URL=http://10.10.0.2:3100/loki/api/v1/push
OBS_PROMETHEUS_REMOTE_WRITE_URL=http://10.10.0.2:9090/api/v1/write
# Read-only PostgreSQL role for the postgres exporter (member of pg_monitor), created/updated
# by db_update (ops/scripts/ensure_monitoring_role.py).
# POSTGRES_MONITORING_PASSWORD: обязательно для Alloy (профиль observability), hex:
#   openssl rand -hex 24
# Пусто = шаг db_update пропускается с предупреждением (роль не создаётся);
# плейсхолдеры вида change_me отклоняются (db_update завершится с кодом 2).
POSTGRES_MONITORING_USER=monitoring
POSTGRES_MONITORING_PASSWORD=
# ALLOY_IMAGE=grafana/alloy:v1.11.3@sha256:8c7256f412feb9f5f48f9f6f9394dc97ca887f63dea9304f347970ecc1787669
# Read-only Docker API proxy for Alloy (only it mounts docker.sock); tag+digest
# DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.4.1@sha256:3400c429c5f9e1b21d62130fb93b16e2e772d4fb7695bd52fc2b743800b9fe9e

# =============================================================================
# OBSERVABILITY STACK (docker-compose.obs.yml, VPS 2) — see docs/ops/observability.md
# =============================================================================
# Start: make obs-up (creates dirs via make init-dirs). Test copy: make env-test, then
# make obs-up ENV_FILE=.env.test (dirs under <PROJECT_DATA_DIR>_test/obs, ports +20000).
# Secrets are interpolated into URLs/configs: use URL-safe values without `$`,
# e.g. `openssl rand -hex 24`.

# Bind-mount data dirs. Grafana/Prometheus/Loki/Alertmanager run as APP_UID:APP_GID,
# so their dirs must belong to APP_UID (make init-dirs checks it).
OBS_POSTGRES_DATA_DIR="${PROJECT_DATA_DIR}/obs/db"
OBS_REDIS_DATA_DIR="${PROJECT_DATA_DIR}/obs/redis"
OBS_GRAFANA_DATA_DIR="${PROJECT_DATA_DIR}/obs/grafana"
OBS_PROMETHEUS_DATA_DIR="${PROJECT_DATA_DIR}/obs/prometheus"
OBS_LOKI_DATA_DIR="${PROJECT_DATA_DIR}/obs/loki"
OBS_ALERTMANAGER_DATA_DIR="${PROJECT_DATA_DIR}/obs/alertmanager"
# Caddy certificates / ACME account
OBS_CADDY_DATA_DIR="${PROJECT_DATA_DIR}/obs/caddy"
# JSON access log of Caddy (written by caddy, read-only for crowdsec)
OBS_CADDY_LOGS_DIR="${PROJECT_DATA_DIR}/obs/caddy-logs"
# CrowdSec config (/etc/crowdsec) and data (/var/lib/crowdsec/data): <dir>/config, <dir>/data
OBS_CROWDSEC_DATA_DIR="${PROJECT_DATA_DIR}/obs/crowdsec"

# Host ports, published on 127.0.0.1 (Loki/Prometheus/GlitchTip: on OBS_INGEST_BIND_ADDRESS)
# (`make env-test` shifts them by +20000)
GRAFANA_PORT_HOST=3000
LOKI_PORT_HOST=3100
PROMETHEUS_PORT_HOST=9090
ALERTMANAGER_PORT_HOST=9093
GLITCHTIP_PORT_HOST=8000
# Address of Loki/Prometheus/GlitchTip ports (Alloy and Sentry SDK of VPS 1 push there): 127.0.0.1 locally,
# VPN IP of VPS 2 in production (never 0.0.0.0).
OBS_INGEST_BIND_ADDRESS=127.0.0.1
# Caddy is the only service published beyond loopback (on CADDY_BIND_ADDRESS)
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT_HOST=80
CADDY_HTTPS_PORT_HOST=443

# Access mode of Caddy (the only public entry of VPS 2); everything is behind HTTP Basic Auth:
#   ip     - https://<VPS_IP>/ (GlitchTip) and https://<VPS_IP>/grafana/ (Grafana),
#            self-signed certificate (tls internal; browser warning, curl -k).
#   domain - GRAFANA_DOMAIN / GLITCHTIP_DOMAIN with Let's Encrypt (+ http -> https redirect);
#            nip.io works without own DNS: grafana.<ip>.nip.io / glitchtip.<ip>.nip.io.
#            Locally *.localhost -> Caddy internal CA.
CADDY_MODE=ip
# Public IPv4 of VPS 2 (CADDY_MODE=ip; locally 127.0.0.1)
VPS_IP=
# Domains (CADDY_MODE=domain only)
GRAFANA_DOMAIN=grafana.localhost
GLITCHTIP_DOMAIN=glitchtip.localhost
# Basic Auth of Caddy (before the Grafana/GlitchTip login). OBS_AUTH_HASH = base64 of a bcrypt
# hash (no `$`), generated by make env / make obs-auth; the password is never stored here.
OBS_AUTH_USER=admin
OBS_AUTH_HASH=
# CrowdSec bouncer key of Caddy (hex, >= 32 chars). Empty -> generated by make env;
# old .env: openssl rand -hex 32. Banned IPs: make obs-bans [UNBAN=<ip>]
CROWDSEC_BOUNCER_KEY=

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# GlitchTip (own PostgreSQL + Valkey inside the obs stack)
OBS_POSTGRES_USER=glitchtip
OBS_POSTGRES_PASSWORD=change_me
OBS_POSTGRES_DB=glitchtip
OBS_REDIS_PASSWORD=change_me
# Django secret key: `openssl rand -hex 32`
GLITCHTIP_SECRET_KEY=change_me
GLITCHTIP_FROM_EMAIL=glitchtip@localhost
# consolemail:// = mails only in container logs; SMTP: smtp://user:pass@host:587
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_MAX_EVENT_LIFE_DAYS=30
GLITCHTIP_ENABLE_USER_REGISTRATION=false
GLITCHTIP_ENABLE_ORGANIZATION_CREATION=false
# GlitchTip bootstrap (make obs-bootstrap, part of make obs-up): idempotently creates the
# superuser, organization, team, project and project key, then writes SENTRY_DSN above.
# Empty GLITCHTIP_ADMIN_PASSWORD / GLITCHTIP_PROJECT_PUBLIC_KEY are generated and written here
# (backup .env.bak). The password of an existing user is never changed by the bootstrap.
GLITCHTIP_ADMIN_EMAIL=admin@glitchtip.local
GLITCHTIP_ADMIN_PASSWORD=
GLITCHTIP_ORG_SLUG=tgshopplatform
GLITCHTIP_ORG_NAME=TgShopPlatform
GLITCHTIP_TEAM_SLUG=platform
GLITCHTIP_PROJECT_NAME=tg-shop-platform
GLITCHTIP_PROJECT_PLATFORM=python
# UUID4; part of the DSN (public, not a secret). Empty -> generated
GLITCHTIP_PROJECT_PUBLIC_KEY=
# GlitchTip URL as seen from app containers (host of SENTRY_DSN; obs network on single host,
# VPN address of VPS 2 in production, e.g. http://10.10.0.2:8000 — set on VPS 2 before
# make obs-up: SENTRY_DSN written by the bootstrap uses this host)
GLITCHTIP_INTERNAL_URL=http://glitchtip-web:8000

# Retention (Loki: retention_period 720h in ops/observability/loki/config.yml)
PROMETHEUS_RETENTION=30d
ALERTMANAGER_RETENTION=720h

# Alertmanager -> Telegram. Empty = alerts are dropped (blackhole receiver).
# CHAT_ID is an integer (groups/channels are negative). `make env-test` empties both.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Pinned images (tag@digest). Uncomment to override:
# LOKI_IMAGE=grafana/loki:3.5.5@sha256:31628519045e7f28692a7ae73b4a3fd293dccb425585ed5d16ceea3b5c9592e6
# PROMETHEUS_IMAGE=prom/prometheus:v3.6.0@sha256:76947e7ef22f8a698fc638f706685909be425dbe09bd7a2cd7aca849f79b5f64
# ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1@sha256:27c475db5fb156cab31d5c18a4251ac7ed567746a2483ff264516437a39b15ba
# GRAFANA_IMAGE=grafana/grafana:12.2.0@sha256:74144189b38447facf737dfd0f3906e42e0776212bf575dc3334c3609183adf7
# GLITCHTIP_IMAGE=glitchtip/glitchtip:v5.1@sha256:805f4fb7b886653b944caff1ae06a95c8724b5b3ddc21917e80e18e6c03019ab
# OBS_POSTGRES_IMAGE=postgres:17-alpine@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac
# OBS_REDIS_IMAGE=valkey/valkey:8.1-alpine@sha256:2602ace2be6569bc2bbb06f873776516ab9089821525be34f4305c67eb9db02a
# CROWDSEC_IMAGE=crowdsecurity/crowdsec:v1.8.2@sha256:65b74942f7e7ed5c60fde4ac15fc4ba715904c398c8b16dd451f4907d90347d4
# Caddy of the stack is built locally (ops/observability/caddy/Dockerfile, versions = ARG there).
# Go module sources of that build (xcaddy). Default: goproxy.cn first (proxy.golang.org zip
# downloads hang / 403 in some regions), then proxy.golang.org, then VCS.
# Change only if the build fails on module downloads (e.g. own mirror / https://goproxy.cn).
# Keep the quotes (`|` must not reach `source`); never disable checksums (GOSUMDB=off).
# CADDY_BUILD_GOPROXY="https://goproxy.cn|https://proxy.golang.org|direct"
# CADDY_BUILD_GOSUMDB=sum.golang.org
# Image of `caddy hash-password` for make obs-auth (official, no modules needed):
# CADDY_AUTH_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
